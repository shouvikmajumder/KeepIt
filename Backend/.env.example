SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
# Use the session pooler or direct Postgres URL, with SSL required in production.
DATABASE_URL=postgresql://postgres:password@localhost:5432/keepit
PLAID_ENVIRONMENT=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# Optional for local Sandbox development. Set these only when the API has a
# public HTTPS URL; the local worker can still perform initial/manual syncs.
PLAID_WEBHOOK_URL=
PLAID_REDIRECT_URI=
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
TOKEN_ENCRYPTION_KEY=
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
