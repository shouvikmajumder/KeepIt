EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key
# Physical iPhones need your computer's LAN address during local development.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
EXPO_PUBLIC_AUTH_REDIRECT_URL=keepit://auth-callback
# Hostname only; configure its apple-app-site-association file for Plaid OAuth.
EXPO_PUBLIC_PLAID_ASSOCIATED_DOMAIN=
