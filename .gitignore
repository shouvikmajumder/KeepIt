# Secrets — matches .env at any depth (e.g. Backend/.env, KeepIt/.env).
.env
.env.*
!.env.example
node_modules/
dist/
test-results/
playwright-report/
.local/

# Python (Backend/) — the virtualenv self-ignores via .venv/.gitignore,
# but these catch compiled files and any stray venv.
.venv/
__pycache__/
*.pyc
